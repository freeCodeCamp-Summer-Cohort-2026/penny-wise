{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "cross-env JWT_SECRET=test-secret NODE_ENV=test jest --runInBand --detectOpenHandles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --no-warn-ignored .",
    "to_swagger": "node scripts/mongo-to-swagger.js > src/docs/generated_openapi.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "mongoose-to-swagger": "^1.5.1",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/__tests__/setup.js"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  }
}
